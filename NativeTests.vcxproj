  <!-- 정적 생성 헤더 변형은 제품 lib로 대체하지 않고 같은 생성 CPP를 해당 헤더로 컴파일한다. -->
  <ItemGroup Condition="('$(NativeTestSuite)'=='SceneUiRuntime' or '$(NativeTestSuite)'=='InGameData') and '$(NativeUseGameDataLibrary)'!='true'">
    <ClCompile Include="GameData\Generated\InGameData\*.g.cpp">
      <InGameDataGenerated>true</InGameDataGenerated>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>GameData/pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)GameData.pch</PrecompiledHeaderOutputFile>
    </ClCompile>
  </ItemGroup>
  <Target Name="GenerateNativeInGameDataBeforeCompile" Condition="'$(DesignTimeBuild)'!='true' and ('$(NativeTestSuite)'=='SceneUiRuntime' or '$(NativeTestSuite)'=='InGameData') and '$(NativeUseGameDataLibrary)'!='true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)GameData\GameData.vcxproj" Targets="GenerateInGameDataBeforeCompile" BuildInParallel="false" Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="OutDir;IntDir;TargetName;NativeTestSuite;NativeGeneratedRoot;NativeWithoutTextArt;NativeUseGameDataLibrary;NativeCoreDependencyNegative" />
  </Target>
  <!-- 같은 생성 target을 공유한다. 생성 실패 시 fixture 갱신과 consumer 실행을 모두 중단한다. -->
  <Target Name="RefreshNativeOptionalHeaders" BeforeTargets="BeforeClCompile;SelectClCompile" DependsOnTargets="GenerateNativeInGameDataBeforeCompile" Condition="'$(DesignTimeBuild)'!='true' and '$(NativeWithoutTextArt)'=='true'">
    <Exec Command="&quot;$(NativePythonExecutable)&quot; -c &quot;import sys; sys.path.insert(0, sys.argv[1]); from native_build import _without_textart; from pathlib import Path; _without_textart(Path(sys.argv[2]), Path(sys.argv[3]))&quot; &quot;$(MSBuildThisFileDirectory)Tools\Tests&quot; &quot;$(NativeGeneratedSourceRoot)\.&quot; &quot;$(OutDir).&quot;" />
  </Target>
  <Target Name="RefreshNativeInGameDataCompileItems" BeforeTargets="BeforeClCompile;SelectClCompile" DependsOnTargets="GenerateNativeInGameDataBeforeCompile;RefreshNativeOptionalHeaders" Condition="('$(NativeTestSuite)'=='SceneUiRuntime' or '$(NativeTestSuite)'=='InGameData') and '$(NativeUseGameDataLibrary)'!='true'">
    <ItemGroup>
      <ClCompile Remove="@(ClCompile)" Condition="'%(ClCompile.InGameDataGenerated)'=='true'" />
      <ClCompile Include="GameData\Generated\InGameData\*.g.cpp">
        <InGameDataGenerated>true</InGameDataGenerated>
        <PrecompiledHeader>Use</PrecompiledHeader>
        <PrecompiledHeaderFile>GameData/pch.h</PrecompiledHeaderFile>
        <PrecompiledHeaderOutputFile>$(IntDir)GameData.pch</PrecompiledHeaderOutputFile>
      </ClCompile>
    </ItemGroup>
  </Target>
  <Target Name="GenerateInGameDataFixtureBeforeCompile" Condition="'$(DesignTimeBuild)'!='true' and '$(NativeTestSuite)'=='InGameData'">
    <Exec EnvironmentVariables="LIB=" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools\GameDataGenerator\GameDataGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --ingame-schema &quot;$(MSBuildThisFileDirectory)Tests\InGameData\Schema\CompatibilityV1.yaml&quot; --ingame-output-root &quot;$(MSBuildThisFileDirectory)Out\Tests\InGameDataSchema\CompatibilityV1&quot; --ingame-namespace TextRPGTest::InGameDataV1 --check">
      <Output TaskParameter="ExitCode" PropertyName="InGameDataCompatibilityV1CheckExitCode" />
    </Exec>
    <Exec Condition="'$(InGameDataCompatibilityV1CheckExitCode)'!='0'" EnvironmentVariables="LIB=" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools\GameDataGenerator\GameDataGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --ingame-schema &quot;$(MSBuildThisFileDirectory)Tests\InGameData\Schema\CompatibilityV1.yaml&quot; --ingame-output-root &quot;$(MSBuildThisFileDirectory)Out\Tests\InGameDataSchema\CompatibilityV1&quot; --ingame-namespace TextRPGTest::InGameDataV1" />
    <Exec EnvironmentVariables="LIB=" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools\GameDataGenerator\GameDataGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --ingame-schema &quot;$(MSBuildThisFileDirectory)Tests\InGameData\Schema\SharedGraph.yaml&quot; --ingame-output-root &quot;$(MSBuildThisFileDirectory)Out\Tests\InGameDataSchema\SharedGraph&quot; --ingame-namespace TextRPGTest::InGameData --check">
      <Output TaskParameter="ExitCode" PropertyName="InGameDataFixtureCheckExitCode" />
    </Exec>
    <Exec Condition="'$(InGameDataFixtureCheckExitCode)'!='0'" EnvironmentVariables="LIB=" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools\GameDataGenerator\GameDataGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --ingame-schema &quot;$(MSBuildThisFileDirectory)Tests\InGameData\Schema\SharedGraph.yaml&quot; --ingame-output-root &quot;$(MSBuildThisFileDirectory)Out\Tests\InGameDataSchema\SharedGraph&quot; --ingame-namespace TextRPGTest::InGameData" />
  </Target>
  <Target Name="RefreshInGameDataFixtureCompileItems" BeforeTargets="BeforeClCompile;SelectClCompile" DependsOnTargets="GenerateInGameDataFixtureBeforeCompile" Condition="'$(NativeTestSuite)'=='InGameData'">
    <ItemGroup>
      <ClCompile Remove="@(ClCompile)" Condition="'%(ClCompile.InGameDataFixture)'=='true'" />
    </ItemGroup>
    <!-- 새 항목은 별도 원본 목록의 metadata로 변환하여 ClCompile 자기 참조 batching을 피한다. -->
    <ItemGroup>
      <_NativeSchemaSharedGraph Include="Out\Tests\InGameDataSchema\SharedGraph\*.g.cpp" />
      <_NativeSchemaCompatibilityV1 Include="Out\Tests\InGameDataSchema\CompatibilityV1\*.g.cpp" />
      <ClCompile Include="@(_NativeSchemaSharedGraph)">
        <InGameDataFixture>true</InGameDataFixture>
        <ObjectFileName>$(IntDir)SchemaSharedGraph_%(_NativeSchemaSharedGraph.Filename).obj</ObjectFileName>
        <PrecompiledHeader>Use</PrecompiledHeader>
        <PrecompiledHeaderFile>GameData/pch.h</PrecompiledHeaderFile>
        <PrecompiledHeaderOutputFile>$(IntDir)GameData.pch</PrecompiledHeaderOutputFile>
      </ClCompile>
      <ClCompile Include="@(_NativeSchemaCompatibilityV1)">
        <InGameDataFixture>true</InGameDataFixture>
        <ObjectFileName>$(IntDir)SchemaCompatibilityV1_%(_NativeSchemaCompatibilityV1.Filename).obj</ObjectFileName>
        <PrecompiledHeader>Use</PrecompiledHeader>
        <PrecompiledHeaderFile>GameData/pch.h</PrecompiledHeaderFile>
        <PrecompiledHeaderOutputFile>$(IntDir)GameData.pch</PrecompiledHeaderOutputFile>
      </ClCompile>
    </ItemGroup>
  </Target>
  <ItemDefinitionGroup Condition="'$(NativeTestSuite)'=='InGameData'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Out\Tests\InGameDataSchema;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(NativeTestSuite)'=='ConsoleGameCore' and '$(NativeCoreDependencyNegative)'=='true'">
