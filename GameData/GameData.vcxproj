  <Target Name="GenerateGameDataBeforeCompile" BeforeTargets="ClCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- 변경 없는 출력은 검사만 하여 기존 PCH/obj 의존 시간과 생성 트리를 보존한다. -->
    <Exec EnvironmentVariables="LIB=" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\Tools\GameDataGenerator\GameDataGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --input-root &quot;$(MSBuildThisFileDirectory)Excel&quot; --output-root &quot;$(MSBuildThisFileDirectory)Class&quot; --yaml-output-root &quot;$(MSBuildThisFileDirectory)Data&quot; --check">
      <Output TaskParameter="ExitCode" PropertyName="GameDataGenerationCheckExitCode" />
    </Exec>
    <!-- 검사 실패는 기존 생성 명령으로 처리하며, 검증/게시 실패는 빌드 실패로 전달한다. -->
    <Exec Condition="'$(GameDataGenerationCheckExitCode)' != '0'" EnvironmentVariables="LIB=" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\Tools\GameDataGenerator\GameDataGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --input-root &quot;$(MSBuildThisFileDirectory)Excel&quot; --output-root &quot;$(MSBuildThisFileDirectory)Class&quot; --yaml-output-root &quot;$(MSBuildThisFileDirectory)Data&quot;" />
